# Redis (session state: conversation history + mailbox streams)
REDIS_URL=redis://localhost:6379

# Backend voice-service WebSocket URLs
# Local (services running on host):
STT_URL=ws://localhost:8001/stt
LLM_URL=ws://localhost:8002/llm
TTS_URL=ws://localhost:8003/tts

# Docker Compose (service-name DNS) — used by docker-compose.yml:
# REDIS_URL=redis://redis:6379
# STT_URL=ws://stt-service:8001/stt
# LLM_URL=ws://llm-service:8002/llm
# TTS_URL=ws://tts-service:8003/tts
