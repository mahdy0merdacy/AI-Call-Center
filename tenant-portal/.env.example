# Origin of the Django backend. Leave empty to call the same origin (e.g. behind a reverse proxy).
# All endpoints are resolved under `${VITE_API_BASE_URL}/api/`.
VITE_API_BASE_URL=http://localhost:8000

# allauth Google entry point. The browser is sent here by "Continue with Google".
VITE_GOOGLE_AUTH_URL=http://localhost:8000/_allauth/browser/v1/auth/provider/redirect
# post = allauth headless form POST (needs a readable csrftoken cookie, i.e. same origin); get = classic allauth URL.
VITE_GOOGLE_AUTH_METHOD=post

# Product name shown in the UI.
VITE_APP_NAME=AI Call Center

# Optional footer links (hidden when empty).
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Set to "true" to intercept every API call with the MSW mock backend (no Django needed).
VITE_ENABLE_MSW=false

# Mock backend only: access-token lifetime in seconds (lower it to watch silent refresh happen).
VITE_MOCK_ACCESS_TTL_SECONDS=900
