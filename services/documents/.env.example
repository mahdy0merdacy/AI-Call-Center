# Copy to .env (never commit .env) and fill in real values.

# --- Docker Compose (docker compose up --build) ---
MONGO_USER=documents
MONGO_PASSWORD=change-me
# Root credentials above are used ONLY by the one-shot mongo-setup job. The app connects as
# its own user, limited to its database. Use letters/digits for the password (it goes in a URL).
MONGO_APP_USER=documents_app
MONGO_APP_PASSWORD=change-me-too
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Public half of the auth service's RS256 key, PEM on one line with newlines as \n
# (single-quote it). Required: without it every request gets 401.
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----'
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_TENANT_CLAIM=tenant_id
# JWT_ALLOWED_ROLES=tenant_admin   # comma-separated; other roles get 403; empty = any
# JWT_ROLE_CLAIM=role
# CORS_ALLOWED_ORIGINS=http://localhost:3000   # browser frontends allowed to call the API
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# APP_PORT=8000
# SESSION_LINK_BASE_URL=https://app.example.com/s

# --- Running manage.py directly on your machine (no Docker) ---
# Point at any MongoDB; include credentials for non-local databases.
# MONGODB_URI=mongodb://localhost:27017
# DJANGO_DEBUG=true

# --- Both ---
MONGODB_DB=documents
# MAX_UPLOAD_SIZE_MB=25
