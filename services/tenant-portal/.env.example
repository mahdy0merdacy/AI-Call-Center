# Copy to .env and fill in real values. Never commit .env.

# --- Django ---------------------------------------------------------------
# Generate with: openssl rand -base64 50
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Number of trusted reverse proxies in front of the app (used for client IPs).
NUM_PROXIES=0
LOG_LEVEL=INFO

# --- Database (docker compose builds DATABASE_URL from these) --------------
# Use a URL-safe password (letters and digits).
POSTGRES_DB=tenant_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
# Outside docker compose, set DATABASE_URL directly instead:
# DATABASE_URL=postgres://portal:change-me@localhost:5432/tenant_portal

# --- Frontend / CORS ------------------------------------------------------
# Base URL used to build links in emails (verification, password reset).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT (RS256) ----------------------------------------------------------
# Paths inside the container (./keys is mounted at /keys read-only).
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
JWT_ISSUER=tenant-portal
JWT_AUDIENCE=ai-voice-platform
# Secure flag on the refresh cookie. Must be True in production (HTTPS).
REFRESH_COOKIE_SECURE=False

# --- MFA ------------------------------------------------------------------
# Master key for encrypting TOTP secrets and hashing backup codes.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=change-me
MFA_REQUIRED_FOR_PLATFORM_ADMIN=True

# --- Google OpenID Connect (see README) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Mailpit in development) ---------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=AI Voice <no-reply@aivoice.local>
