# Copy to .env (never commit .env). Use the SAME values as the other two stacks:
# services/documents/.env and services/tenant-portal/.env.

# --- MongoDB (documents service) ---
MONGO_APP_USER=documents_app
MONGO_APP_PASSWORD=change-me-too
MONGODB_DB=documents

# --- Postgres (tenant-portal, holds document_chunks) ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tenant_portal

# POLL_INTERVAL_SECONDS=5

# --- Running on your machine without Docker: set these instead ---
# MongoDB has no published port, so this needs a port mapping on the mongo service.
# MONGODB_URI=mongodb://documents_app:...@localhost:27017/documents?authSource=documents
# DATABASE_URL=postgresql://portal:...@localhost:5434/tenant_portal
# MEDIA_ROOT=./media
